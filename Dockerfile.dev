# ==============================================================================
# ESOCS Administration Platform — Development Dockerfile
# ==============================================================================
# Fast development environment with hot-reloading support.

FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=development
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

EXPOSE 3001

CMD ["npm", "run", "dev"]

