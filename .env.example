# ─── Required ───────────────────────────────────────────────────────────────
# Public URL of this portal (used for links in emails, share links, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# REST API base URL (.NET Platform.Api on port 5080).
# Server-side only: the browser never talks to the API directly, so tokens never reach client JavaScript.
BACKEND_API_URL=http://localhost:5080/api/v1

# Tenant slug for multi-tenancy header (matches seeded tenant in backend)
TENANT_SLUG=esocs

# ─── Optional ───────────────────────────────────────────────────────────────
# Minutes of inactivity before the "still there?" warning, then sign-out.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=15

# Base64 32-byte key so Server Action IDs stay valid across instances.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Set to "true" to expose /design-system in production builds.
# ENABLE_DESIGN_SYSTEM=false

# Comma-separated https origins allowed to embed public forms in an iframe,
# e.g. https://www.esocs.org. Leave empty to block embedding.
# FORM_EMBED_ORIGINS=
