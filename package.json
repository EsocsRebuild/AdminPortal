    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.12"
  },
